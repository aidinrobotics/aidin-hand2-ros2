<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aidin_hand2_hardware</name>
  <version>0.3.1</version>
  <description>AIDIN Hand Gen2 SDK ros2_control hardware interface.</description>
  <maintainer email="jinh.lee@aidinrobotics.co.kr">jinh.lee</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <!-- C++ SDK (cpp/). colcon 이 plain-CMake 패키지로 빌드 — rosdep 키가 아니라
       워크스페이스 밖에서는 CMAKE_PREFIX_PATH 로 SDK install prefix 를 지정한다. -->
  <depend>aidin_hand2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
