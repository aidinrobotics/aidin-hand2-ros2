<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aidin_hand2_controllers</name>
  <version>0.4.0</version>
  <description>AIDIN Hand Gen2 ros2_control command controllers and broadcasters.</description>
  <maintainer email="jinh.lee@aidinrobotics.co.kr">jinh.lee</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>aidin_hand2_msgs</depend>
  <!-- aidin_hand2 C++ library, not a rosdep key. Used for the structural constants and the
       lifecycle, homing and fault names. Point at it with CMAKE_PREFIX_PATH -->
  <depend>aidin_hand2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
