<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aidin_hand2_controllers</name>
  <version>0.1.0</version>
  <description>AIDIN Hand Gen2 ros2_control command controllers and broadcasters.</description>
  <maintainer email="jinh.lee@aidinrobotics.co.kr">jinh.lee</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>aidin_hand2_msgs</depend>
  <!-- SDK public 헤더 (gain 기본값·ActuatorFault 이름). CMAKE_PREFIX_PATH 로 지정. -->
  <depend>aidin_hand2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
