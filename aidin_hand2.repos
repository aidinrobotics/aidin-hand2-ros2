# SDK revision to clone. The URDF joint limits follow the workspace clamp of 0.7.1, built for
# hand type A or B. Any 0.7.x builds, because the wrapper's find_package(aidin_hand2 0.7 REQUIRED)
# uses SameMinorVersion.
#   vcs import .. < aidin_hand2.repos
repositories:
  aidin-hand2-sdk:
    type: git
    url: git@github.com:aidinrobotics/aidin-hand2-sdk.git
    version: v0.7.1
