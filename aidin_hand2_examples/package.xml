<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aidin_hand2_examples</name>
  <version>0.1.0</version>
  <description>AIDIN Hand Gen2 ROS2 chainable controller examples (controller 성격별 구성).</description>
  <maintainer email="jinh.lee@aidinrobotics.co.kr">jinh.lee</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>aidin_hand2_msgs</depend>
  <!-- scripts/glove_teleop/glove_calibrate.py (Python 캘리브 스크립트) -->
  <exec_depend>rclpy</exec_depend>

  <!-- glove teleop chainable controller (manus_ros2_msgs 가 워크스페이스에 있을 때만 빌드) -->
  <depend>controller_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>manus_ros2_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
