<?xml version="1.0"?>
<!--
  Hand-left macro for aidin_hand2.

  GENERATED as the true geometric mirror of aidin_hand2_right.urdf.xacro across the
  XZ plane (M = diag(1,-1,1), i.e. Y -> -Y).  Per-element rule:
    - link/joint origin xyz : negate Y
    - link/joint origin rpy : R' = M R M  (재계산)
    - inertia tensor        : ixy, iyz 부호 반전 (ixx/iyy/izz/ixz 불변)
    - joint axis            : a' = -M a
    - mass / limit / effort / velocity : 불변 (right와 동일)
    - palm mesh             : body_right.STL -> body_left.STL
    - 손가락 mesh           : 좌우 공용 STL 재사용 + link-local Y scale 로 mirror
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="aidin_hand2_left"
               params="prefix:='left_' parent:='world' *origin">

    <!-- Joint connecting to parent -->
    <joint name="${prefix}hand_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}hand_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- ================================ base link ================================ -->
    <link name="${prefix}hand_base_link">
      <inertial>
        <origin xyz="0.00320138275084623 -0.000486961406823378 0.0551088066173012" rpy="0 0 0"/>
        <mass value="0.224653931713756"/>
        <inertia
          ixx="0.0001829801686329" ixy="-5.97967829542247E-07" ixz="-2.90350893810316E-06"
          iyy="9.92584141817906E-05" iyz="1.62408221940103E-06"
          izz="0.000137495988458663"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aidin_hand2_description/meshes/visual/body_left.STL"/>
        </geometry>
        <material name="">
          <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aidin_hand2_description/meshes/collision/body_left.STL"/>
        </geometry>
      </collision>
    </link>

    <!-- ================================ thumb  ================================ -->
    <link name="${prefix}thumb_link0">
      <inertial>
        <origin xyz="-0.000530418447680113 -0.0181722170592327 -0.00309086613343537" rpy="0 0 0"/>
        <mass value="0.0260533922416012"/>
        <inertia
          ixx="4.24619727662572E-06" ixy="3.63537752061735E-07" ixz="4.35690374733072E-08"
          iyy="1.06435704456071E-06" iyz="-9.27840158955382E-07"
          izz="4.06145127815098E-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aidin_hand2_description/meshes/visual/thumb_link0.STL" scale="1 -1 1"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
